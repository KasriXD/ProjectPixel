# cmake -DOUT=<folder> -P FetchSdlJava.cmake
# Puts SDL's Java side of an Android app (org/libsdl/app/*.java) in <folder>,
# from the same SDL release as the native build (cmake/PxSdlVersion.cmake).
# The Gradle build runs it before compiling Java.
cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/PxSdlVersion.cmake")
if(NOT OUT)
    message(FATAL_ERROR "usage: cmake -DOUT=<folder> -P FetchSdlJava.cmake")
endif()
set(stamp "${OUT}/.sdl-${PX_SDL_VERSION}")
if(EXISTS "${stamp}")
    return()
endif()
get_filename_component(work "${OUT}/../sdl-download" ABSOLUTE)
set(archive "${work}/SDL3-${PX_SDL_VERSION}.tar.gz")
if(NOT EXISTS "${archive}")
    file(DOWNLOAD "${PX_SDL_URL}" "${archive}" EXPECTED_HASH SHA256=${PX_SDL_SHA256} STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${archive}")
        message(FATAL_ERROR "Could not download ${PX_SDL_URL}: ${status}")
    endif()
endif()
file(REMOVE_RECURSE "${work}/extracted")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}/extracted"
     PATTERNS "SDL3-${PX_SDL_VERSION}/android-project/app/src/main/java")
set(java "${work}/extracted/SDL3-${PX_SDL_VERSION}/android-project/app/src/main/java")
if(NOT EXISTS "${java}/org/libsdl/app/SDLActivity.java")
    message(FATAL_ERROR "SDLActivity.java is not in ${archive}")
endif()
file(REMOVE_RECURSE "${OUT}")
file(COPY "${java}/" DESTINATION "${OUT}")
file(TOUCH "${stamp}")
message(STATUS "SDL ${PX_SDL_VERSION} Java sources in ${OUT}")
